#!/bin/sh
# What every owlab container needs regardless of what is being developed
# on it. Runs once, on first boot, from procd's boot sequence.
#
# Fixture profiles (which invent VLANs, WireGuard peers, DHCP leases and so
# on) are separate files and are opt-in. This one is not optional: without it
# the container either hands out DHCP to its own Docker network or answers
# only on https with a self-signed certificate.

# The container's single interface is Docker's, on Docker's subnet, shared
# with every other container on that network. Serving DHCP there means racing
# Docker's own IPAM to answer other containers — so dnsmasq keeps running (LuCI
# has pages for it, and fixture leases want a leasefile) but stops offering
# addresses.
uci -q set dhcp.lan.ignore='1'

# Plain HTTP on all interfaces. The default redirects to https with a
# self-signed certificate, which every browser interrupts and every scripted
# check has to be told to ignore — for a throwaway dev box on localhost that
# is pure friction. Port 80 inside is what compose forwards to the host.
uci -q set uhttpd.main.listen_http='0.0.0.0:80'
uci -q delete uhttpd.main.listen_https
uci -q delete uhttpd.main.redirect_https

# The attended-sysupgrade check fires a modal on the first LuCI page load and
# lands in the middle of every screenshot. There is nothing to upgrade to in a
# container anyway.
uci -q set attendedsysupgrade.client.login_check_for_upgrades='0'

# Activate the theme under development, if there is one.
#
# Installing a theme package only REGISTERS it — it adds luci.themes.<Name>
# and leaves luci.main.mediaurlbase alone, because a package has no business
# changing what the user is looking at. On a dev box that is exactly backwards:
# the whole reason the theme is here is to be looked at.
#
# This runs after the package's own 30_luci-theme-* uci-default (numbered
# lower), so it wins. It also matters for more than cosmetics: LuCI resolves
# templates through mediaurlbase, and pointing it at a theme whose templates
# are missing crashes the dispatcher rather than falling back.
if [ -s /etc/owlab/theme ]; then
	theme="$(cat /etc/owlab/theme)"
	if [ -d "/www/luci-static/$theme" ]; then
		uci -q set luci.main.mediaurlbase="/luci-static/$theme"
	else
		echo "owlab: theme '$theme' asked for, but /www/luci-static/$theme does not exist" >&2
	fi
fi

# Flow offloading, switched off only where it cannot work.
#
# ImmortalWrt enables it by default (firewall.@defaults[0].flow_offloading='1'
# and _hw='1'); OpenWrt does not ship the key at all. The offload rule needs a
# flowtable, and a flowtable needs nf_flow_table in the RUNNING kernel. In a
# container the running kernel is the engine's, which generally has no such
# module and cannot be given one — so nft rejects the WHOLE ruleset:
#
#   flowtable ft { ... Error: Could not process rule: No such file or directory
#   meta l4proto { tcp, udp } flow offload @ft;
#
# What survives is the base chains with `policy drop` and no jumps into any
# zone, so the router answers a TCP handshake and then resets — measured as
# "connection reset by peer" against a uhttpd that is up and listening.
#
# On a vm router the kernel is OpenWrt's own and the flowtable is created
# without complaint, so the feature is left exactly as the distribution
# configured it. Hence a probe rather than a blanket disable: the question is
# not which tier this is, it is whether THIS kernel can do it.
#
# The modprobe is not optional. OpenWrt ships no modules.alias, so the kernel
# cannot autoload a module by the alias nft asks for — the probe would fail
# for a router that is perfectly capable, purely because nothing had loaded
# nf_flow_table yet. Loading it by name first makes the answer about the
# kernel rather than about what happened to run earlier in the boot.
modprobe nf_flow_table 2>/dev/null
modprobe nf_flow_table_inet 2>/dev/null

if nft add table inet owlab_probe 2>/dev/null; then
	if ! nft add flowtable inet owlab_probe ft '{ hook ingress priority filter; devices = { lo }; }' 2>/dev/null; then
		uci -q set firewall.@defaults[0].flow_offloading='0'
		uci -q set firewall.@defaults[0].flow_offloading_hw='0'
		echo "owlab: this kernel has no flowtable support, disabling flow offloading (it would take the whole firewall down)"
	fi
	nft delete table inet owlab_probe 2>/dev/null
fi

# Keep the container's own interface inside a firewall zone that accepts input.
#
# fw4 renders a zone as `iifname "<dev>" jump input_<zone>` and works out
# <dev> from the zone's `network` list when it builds the ruleset. A zone that
# resolves to no device emits no jump, and the packet then falls off the end
# of the input chain into `jump handle_reject` — a TCP reset, seen from the
# host as an empty reply and from a sibling container as "Connection refused",
# against a uhttpd that is up and listening on 0.0.0.0:80. Measured on
# imm 25.12.1 by taking the network back out of the zone:
#
#   chain input {                       # policy drop
#     iifname "dummy0" jump input_wan   # ... and no br-lan line
#     jump handle_reject                # so lan traffic lands here
#   }
#   $ curl -o /dev/null -w '%{http_code}' http://localhost:18026/cgi-bin/luci/
#   000                                 # curl exit 52, empty reply
#
# That is the shape reported in owfeed/owlab#3, where the ImmortalWrt routers
# on a stand were unreachable on their published ports and the OpenWrt ones
# beside them were not. Both distributions ship a lan zone with input ACCEPT,
# so on a boot that goes well this changes nothing — it is here because the
# one interface the container is reachable on must not depend on netifd having
# finished with `lan` at the moment fw4 read the config.
#
# `device` is what makes that true: fw4 takes it literally instead of asking
# netifd, and deduplicates it against the same device found through `network`.
# Measured with both keys set: one `iifname "br-lan" jump input_lan` line, and
# 403 back from LuCI.
#
# The zone is repaired rather than the firewall switched off, for the reason
# given further down: fw4 works in here, and disabling it would hide a whole
# class of real behaviour.
lan_dev="$(uci -q get network.lan.device)"
[ -n "$lan_dev" ] || lan_dev="br-lan"

lan_zone=""
i=0
while [ -n "$(uci -q get "firewall.@zone[$i]")" ]; do
	if [ "$(uci -q get "firewall.@zone[$i].name")" = "lan" ]; then
		lan_zone="@zone[$i]"
		break
	fi
	for net in $(uci -q get "firewall.@zone[$i].network"); do
		[ "$net" = "lan" ] && lan_zone="@zone[$i]"
	done
	[ -n "$lan_zone" ] && break
	i=$((i + 1))
done

if [ -z "$lan_zone" ]; then
	uci -q add firewall zone >/dev/null
	uci -q set firewall.@zone[-1].name='lan'
	uci -q set firewall.@zone[-1].output='ACCEPT'
	uci -q set firewall.@zone[-1].forward='ACCEPT'
	uci -q add_list firewall.@zone[-1].network='lan'
	lan_zone="@zone[-1]"
	echo "owlab: no firewall zone covered the lan network, created one"
fi

uci -q set "firewall.$lan_zone.input=ACCEPT"

# add_list appends without looking, so ask before adding.
have=""
for dev in $(uci -q get "firewall.$lan_zone.device"); do
	[ "$dev" = "$lan_dev" ] && have=1
done
[ -n "$have" ] || uci -q add_list "firewall.$lan_zone.device=$lan_dev"

# dropbear listens on one address, and it is not the one that has to work.
#
# ImmortalWrt ships `option Interface 'lan'`; OpenWrt ships no such key.
# Measured on the same stand, netstat -ltnp inside each container:
#
#   imm2512    tcp 0 0 192.168.163.5:22  LISTEN  2262/dropbear
#   owrt2512   tcp 0 0 0.0.0.0:22        LISTEN   889/dropbear
#
# Binding a single interface address bets that netifd finished with `lan`
# before dropbear started and that nothing will ever arrive on another
# address. A container that is recreated constantly, published to the host and
# occasionally on a second docker network makes both of those a bad bet — the
# reported symptom is an ssh connection closed the moment it is opened.
# Dropping the key restores the wildcard bind.
i=0
while [ -n "$(uci -q get "dropbear.@dropbear[$i]")" ]; do
	uci -q delete "dropbear.@dropbear[$i].Interface"
	i=$((i + 1))
done

uci commit

# Stop the services that cut a container off from its own network.
#
# These are not arbitrary. Each was measured taking the box down:
#
#   mwan3     watches the WAN, decides a dummy interface is dead, and installs
#             ip rules that blackhole everything:
#               2061: from all fwmark 0x3d00/0x3f00 blackhole
#               3001: from all fwmark 0x100/0x3f00 unreachable
#             The symptom is a router that answers on LuCI while every
#             outbound connection hangs — `apk add` sits there forever.
#   watchcat  reboots or reconnects on a schedule when it thinks the network
#             is down, which in here it always does.
#
# They are stopped rather than uninstalled: the LuCI pages stay, which is the
# reason someone installed them on a dev box in the first place. Anyone who
# genuinely wants them running can start them by hand.
#
# The firewall is deliberately NOT in this list. fw4 works in a container —
# measured, 193 rules loaded, and the box stays reachable — and turning it off
# would hide a whole class of real behaviour.
for svc in mwan3 watchcat; do
	if [ -x "/etc/init.d/$svc" ]; then
		"/etc/init.d/$svc" stop >/dev/null 2>&1
		"/etc/init.d/$svc" disable >/dev/null 2>&1
		echo "owlab: stopped $svc (it blackholes traffic when the WAN is a dummy)"
	fi
done

# LuCI caches its dispatch tree and its module list. Both were built before
# the packages above were installed, so they describe a router that no longer
# exists.
rm -f /tmp/luci-indexcache*
rm -rf /tmp/luci-modulecache

exit 0
